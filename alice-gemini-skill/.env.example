# API-ключ Google AI Studio (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Актуальная модель Gemini (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Опционально: URL прокси для обхода геоблокировок Google в РФ (например, Cloudflare Worker)
# GEMINI_BASE_URL=https://your-worker-name.workers.dev

# Температура генерации (0.3 для кратких и точных ответов)
TEMPERATURE=0.3

# Лимиты токенов и длины ответа (для быстрого и комфортного озвучивания Алисой)
MAX_OUTPUT_TOKENS=350
MAX_RESPONSE_LENGTH=600

# Таймаут запроса к Gemini API в секундах
GEMINI_TIMEOUT_SECONDS=3.5

# Порт локального веб-сервера
PORT=8000
